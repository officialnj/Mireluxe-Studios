# MIRILUXE Studios — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-side only, full admin access — never expose to the client or commit it
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────
# Test-mode keys from the Stripe dashboard (Developers → API keys) while account verification is pending
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Same value as STRIPE_PUBLISHABLE_KEY — NEXT_PUBLIC_ prefix required for Next.js to inline it client-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Generated when the webhook endpoint is registered (Developers → Webhooks, or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=

# ── Resend / Email ───────────────────────────────────────
# Resend is the sending relay for ALL transactional email (booking
# confirmations, reminders, reschedule/cancellation notices, shop orders,
# admin alerts). See docs/INTEGRATIONS.md for account setup, domain
# verification (SPF/DKIM/DMARC) and getting this key.
RESEND_API_KEY=re_...
# Reply-to address on every outgoing email — an inbox the studio already
# checks day-to-day. NOT an SMTP sender, just where customer replies land.
# Falls back to Mireluxestudios@outlook.com if unset (see lib/email/templates.ts).
EMAIL_REPLY_TO=Mireluxestudios@outlook.com

# ── App config ───────────────────────────────────────────
# Base URL used for building absolute links in emails etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where new-booking notifications are sent
ADMIN_NOTIFICATION_EMAIL=hello@miriluxestudios.com
# Shared secret for cron routes (expire-bookings, bookings/cron/reminders)
# bearer-auth'd as `Authorization: Bearer <value>` — generate with `openssl rand -hex 32`
CRON_SECRET=
